async function cargarMenu() {
  const response = await fetch('menu.json');
  const data = await response.json();

  const dias = ["domingo","lunes","martes","miercoles","jueves","viernes","sabado"];
  const hoy = dias[new Date().getDay()];

  const menuHoy = data[hoy];

  const contenedorHoy = document.getElementById("menu-hoy");
  const semana = document.getElementById("semana");

  if(menuHoy){
    contenedorHoy.innerHTML = `
      <h2>${hoy.charAt(0).toUpperCase() + hoy.slice(1)}</h2>

      <h3>Primeros</h3>
      <ul>
        ${menuHoy.primeros.map(item => `<li>${item}</li>`).join('')}
      </ul>

      <h3>Segundos</h3>
      <ul>
        ${menuHoy.segundos.map(item => `<li>${item}</li>`).join('')}
      </ul>

      <h3>Dieta y plancha</h3>
      <ul>
        ${menuHoy.dieta.map(item => `<li>${item}</li>`).join('')}
      </ul>
    `;
  }

  semana.innerHTML = '';

  Object.keys(data).forEach(dia => {
    semana.innerHTML += `
      <div class="card">
        <h2>${dia.charAt(0).toUpperCase() + dia.slice(1)}</h2>

        <strong>Primeros</strong>
        <ul>
          ${data[dia].primeros.map(item => `<li>${item}</li>`).join('')}
        </ul>

        <strong>Segundos</strong>
        <ul>
          ${data[dia].segundos.map(item => `<li>${item}</li>`).join('')}
        </ul>
      </div>
    `;
  });
}

cargarMenu();